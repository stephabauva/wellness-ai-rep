#!/bin/bash
# Direct Claude Code Command: safe-refactor
# Usage: safe-refactor [prompt]

# Get the project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$#" -eq 0 ]; then
    node "$PROJECT_ROOT/slash-command-parser.js" "/safe-refactor"
else
    node "$PROJECT_ROOT/slash-command-parser.js" "/safe-refactor $*"
fi
