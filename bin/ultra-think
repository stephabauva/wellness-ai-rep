#!/bin/bash
# Direct Claude Code Command: ultra-think
# Usage: ultra-think [prompt]

# Get the project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$#" -eq 0 ]; then
    node "$PROJECT_ROOT/slash-command-parser.js" "/ultra-think"
else
    node "$PROJECT_ROOT/slash-command-parser.js" "/ultra-think $*"
fi
