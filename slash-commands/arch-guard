#!/bin/bash
# Claude Code Slash Command: /arch-guard
# Usage: ./arch-guard [prompt]

# Change to parent directory to find slash-command-parser.js
cd "$(dirname "$0")/.."

if [ "$#" -eq 0 ]; then
    node slash-command-parser.js "/arch-guard"
else
    node slash-command-parser.js "/arch-guard $*"
fi
