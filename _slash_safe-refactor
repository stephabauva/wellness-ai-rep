#!/bin/bash
# True Slash Command: /safe-refactor
# Usage: ./_slash_safe-refactor [prompt]

PROJECT_ROOT="$(dirname "${BASH_SOURCE[0]}")"

if [ "$#" -eq 0 ]; then
    node "$PROJECT_ROOT/slash-command-parser.js" "/safe-refactor"
else
    node "$PROJECT_ROOT/slash-command-parser.js" "/safe-refactor $*"
fi
