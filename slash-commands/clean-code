#!/bin/bash
# Claude Code Slash Command: /clean-code
# Usage: ./clean-code [prompt]

# Change to parent directory to find slash-command-parser.js
cd "$(dirname "$0")/.."

if [ "$#" -eq 0 ]; then
    node slash-command-parser.js "/clean-code"
else
    node slash-command-parser.js "/clean-code $*"
fi
